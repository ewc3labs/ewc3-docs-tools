{
  "include": [
    "README.md",
    "AGENTS.md",
    "docs/**.md"
  ],
  "exclude": [
    "docs/project_v2/**.md"
  ],
  "values": {
    "lastDOCSNum": {
      "lastId": {
        "prefix": "DOCS"
      }
    },
    "lastDOCS": {
      "template": {
        "text": "DOCS-${lastDOCSNum}"
      }
    },
    "lastFIXNum": {
      "lastId": {
        "prefix": "FIX"
      }
    },
    "lastFIX": {
      "template": {
        "text": "FIX-${lastFIXNum}"
      }
    }
  },
  "series": {
    "widths": {
      "DOCS": 3
    }
  }
}
